import matplotlib.pyplot as plt

x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 25, 30]

# Line plot
plt.figure()
plt.plot(x, y)
plt.title("Line Plot")
plt.xlabel("X")
plt.ylabel("Y")
plt.show()

# Scatter plot
plt.figure()
plt.scatter(x, y)
plt.title("Scatter Plot")
plt.xlabel("X")
plt.ylabel("Y")
plt.show()

# Box plot
plt.figure()
plt.boxplot([x, y])
plt.title("Box Plot")
plt.show()

# Bar chart
plt.figure()
plt.bar(["A", "B", "C", "D", "E"], y)
plt.title("Bar Chart")
plt.show()

# Pie chart
plt.figure()
plt.pie([30, 25, 20, 15, 10], labels=["A", "B", "C", "D", "E"], autopct="%1.1f%%")
plt.title("Pie Chart")
plt.show()
